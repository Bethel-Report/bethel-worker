# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EMAIL_QUEUE=email.queue
RABBITMQ_RETRY_MAX=3
RABBITMQ_RETRY_INITIAL_INTERVAL=2000

# SMTP — Worker
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
